.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Source data is NOT redistributed here. It is downloaded from its original
# publisher at build time and cached under data/external/. See sources/registry.py.
data/external/
data/raw/*.parquet
!data/raw/.gitkeep

# The DERIVED artefacts ARE committed: they are what the deployed application
# reads, they total about 4 MB, and under CC BY 4.0 an adaptation may be
# redistributed with attribution — which every page of the application carries.
!data/processed/
!data/processed/*.parquet
!data/processed/*.json
!models/
!models/*.json
models/*.joblib

.DS_Store
.env
